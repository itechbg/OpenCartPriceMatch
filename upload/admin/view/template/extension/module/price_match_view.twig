{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-price-match-view" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary">
          <i class="fa fa-save"></i>
        </button>
        <a href="{{ back }}" data-toggle="tooltip" title="{{ button_back }}" class="btn btn-default">
          <i class="fa fa-reply"></i>
        </a>
      </div>
      <h1>{{ heading_title }} &mdash; {{ text_view }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>

  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible">
      <i class="fa fa-exclamation-circle"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}

    {% if success %}
    <div class="alert alert-success alert-dismissible">
      <i class="fa fa-check-circle"></i> {{ success }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}

    <div class="row">
      <!-- Request Details (read-only) -->
      <div class="col-sm-6">
        <div class="panel panel-default">
          <div class="panel-heading">
            <h3 class="panel-title"><i class="fa fa-info-circle"></i> {{ label_product }} &amp; {{ label_customer }}</h3>
          </div>
          <div class="panel-body">
            <div class="table-responsive">
              <table class="table table-striped table-bordered">
                <tbody>
                  <tr>
                    <td><strong>{{ label_product }}</strong></td>
                    <td>
                      <a href="index.php?route=catalog/product/edit&user_token={{ user_token }}&product_id={{ product_id }}" target="_blank">
                        {{ product_name }}
                      </a>
                    </td>
                  </tr>
                  <tr>
                    <td><strong>{{ label_customer }}</strong></td>
                    <td>{{ firstname }} {{ lastname }}</td>
                  </tr>
                  <tr>
                    <td><strong>{{ label_email }}</strong></td>
                    <td><a href="mailto:{{ email }}">{{ email }}</a></td>
                  </tr>
                  <tr>
                    <td><strong>{{ label_telephone }}</strong></td>
                    <td>{{ telephone ? telephone : '&mdash;' }}</td>
                  </tr>
                  <tr>
                    <td><strong>{{ label_date_added }}</strong></td>
                    <td>{{ date_added }}</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>

      <!-- Competitor Details (read-only) -->
      <div class="col-sm-6">
        <div class="panel panel-default">
          <div class="panel-heading">
            <h3 class="panel-title"><i class="fa fa-shopping-cart"></i> {{ label_competitor_name }}</h3>
          </div>
          <div class="panel-body">
            <div class="table-responsive">
              <table class="table table-striped table-bordered">
                <tbody>
                  <tr>
                    <td><strong>{{ label_competitor_name }}</strong></td>
                    <td>{{ competitor_name }}</td>
                  </tr>
                  <tr>
                    <td><strong>{{ label_competitor_url }}</strong></td>
                    <td>
                      <a href="{{ competitor_url }}" target="_blank" rel="noopener noreferrer">
                        {{ competitor_url }}
                      </a>
                    </td>
                  </tr>
                  <tr>
                    <td><strong>{{ label_competitor_price }}</strong></td>
                    <td>{{ competitor_price }}</td>
                  </tr>
                  {% if comment %}
                  <tr>
                    <td><strong>{{ entry_comment }}</strong></td>
                    <td>{{ comment }}</td>
                  </tr>
                  {% endif %}
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Editable Fields -->
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-edit"></i> {{ label_admin_comment }}</h3>
      </div>
      <div class="panel-body">
        <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-price-match-view" class="form-horizontal">

          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-status">{{ label_status }}</label>
            <div class="col-sm-10">
              <select name="status" id="input-status" class="form-control" style="max-width:200px;">
                <option value="0" {% if status == 0 %}selected="selected"{% endif %}>{{ text_pending }}</option>
                <option value="1" {% if status == 1 %}selected="selected"{% endif %}>{{ text_approved }}</option>
                <option value="2" {% if status == 2 %}selected="selected"{% endif %}>{{ text_rejected }}</option>
              </select>
            </div>
          </div>

          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-admin-comment">{{ label_admin_comment }}</label>
            <div class="col-sm-10">
              <textarea name="admin_comment" id="input-admin-comment" rows="5" class="form-control">{{ admin_comment }}</textarea>
            </div>
          </div>

        </form>
      </div>
    </div>

  </div>
</div>
{{ footer }}
