{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="button" id="button-delete" data-toggle="tooltip" title="{{ button_delete }}" class="btn btn-danger">
          <i class="fa fa-trash-o"></i>
        </button>
      </div>
      <h1>{{ heading_title }} &mdash; {{ text_list }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>

  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible">
      <i class="fa fa-exclamation-circle"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}

    {% if success %}
    <div class="alert alert-success alert-dismissible">
      <i class="fa fa-check-circle"></i> {{ success }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}

    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-list"></i> {{ text_list }}</h3>
      </div>

      <div class="panel-body">
        <div class="well">
          <div class="row">
            <div class="col-sm-4">
              <div class="form-group">
                <label class="control-label" for="input-filter-product">{{ column_product }}</label>
                <input type="text" name="filter_product" value="{{ filter_product }}" placeholder="{{ column_product }}" id="input-filter-product" class="form-control" />
              </div>
            </div>
            <div class="col-sm-4">
              <div class="form-group">
                <label class="control-label" for="input-filter-email">{{ column_email }}</label>
                <input type="text" name="filter_email" value="{{ filter_email }}" placeholder="{{ column_email }}" id="input-filter-email" class="form-control" />
              </div>
            </div>
            <div class="col-sm-4">
              <div class="form-group">
                <label class="control-label" for="input-filter-status">{{ column_status }}</label>
                <select name="filter_status" id="input-filter-status" class="form-control">
                  <option value="">{{ text_all_statuses }}</option>
                  <option value="0" {% if filter_status == '0' %}selected="selected"{% endif %}>{{ text_pending }}</option>
                  <option value="1" {% if filter_status == '1' %}selected="selected"{% endif %}>{{ text_approved }}</option>
                  <option value="2" {% if filter_status == '2' %}selected="selected"{% endif %}>{{ text_rejected }}</option>
                </select>
              </div>
            </div>
          </div>
          <div class="row">
            <div class="col-sm-12 text-right">
              <button type="button" id="button-filter" class="btn btn-primary">
                <i class="fa fa-search"></i> {{ button_filter }}
              </button>
            </div>
          </div>
        </div>

        <form action="{{ delete }}" method="post" enctype="multipart/form-data" id="form-price-match-list">
          <div class="table-responsive">
            <table class="table table-bordered table-hover">
              <thead>
                <tr>
                  <td style="width:1px;" class="text-center">
                    <input type="checkbox" onclick="$('input[name*=\'selected\']').prop('checked', this.checked);" />
                  </td>
                  <td class="text-left">
                    <a href="{{ sort_product }}">{{ column_product }}
                      {% if sort == 'pd.name' %}
                        {% if order == 'ASC' %}<i class="fa fa-sort-asc"></i>{% else %}<i class="fa fa-sort-desc"></i>{% endif %}
                      {% else %}<i class="fa fa-sort"></i>{% endif %}
                    </a>
                  </td>
                  <td class="text-left">{{ column_customer }}</td>
                  <td class="text-left">
                    <a href="{{ sort_email }}">{{ column_email }}
                      {% if sort == 'pm.email' %}
                        {% if order == 'ASC' %}<i class="fa fa-sort-asc"></i>{% else %}<i class="fa fa-sort-desc"></i>{% endif %}
                      {% else %}<i class="fa fa-sort"></i>{% endif %}
                    </a>
                  </td>
                  <td class="text-left">{{ column_competitor }}</td>
                  <td class="text-right">
                    <a href="{{ sort_competitor_price }}">{{ column_price }}
                      {% if sort == 'pm.competitor_price' %}
                        {% if order == 'ASC' %}<i class="fa fa-sort-asc"></i>{% else %}<i class="fa fa-sort-desc"></i>{% endif %}
                      {% else %}<i class="fa fa-sort"></i>{% endif %}
                    </a>
                  </td>
                  <td class="text-center">{{ column_status }}</td>
                  <td class="text-left">
                    <a href="{{ sort_date_added }}">{{ column_date_added }}
                      {% if sort == 'pm.date_added' %}
                        {% if order == 'ASC' %}<i class="fa fa-sort-asc"></i>{% else %}<i class="fa fa-sort-desc"></i>{% endif %}
                      {% else %}<i class="fa fa-sort"></i>{% endif %}
                    </a>
                  </td>
                  <td class="text-right">{{ column_action }}</td>
                </tr>
              </thead>
              <tbody>
                {% if requests %}
                  {% for request in requests %}
                  <tr>
                    <td class="text-center">
                      <input type="checkbox" name="selected[]" value="{{ request.price_match_id }}" />
                    </td>
                    <td class="text-left">{{ request.product_name }}</td>
                    <td class="text-left">{{ request.firstname }} {{ request.lastname }}</td>
                    <td class="text-left">{{ request.email }}</td>
                    <td class="text-left">{{ request.competitor_name }}</td>
                    <td class="text-right">{{ request.competitor_price }}</td>
                    <td class="text-center">
                      {% if request.status == 0 %}
                        <span class="label label-warning">{{ request.status_text }}</span>
                      {% elseif request.status == 1 %}
                        <span class="label label-success">{{ request.status_text }}</span>
                      {% else %}
                        <span class="label label-danger">{{ request.status_text }}</span>
                      {% endif %}
                    </td>
                    <td class="text-left">{{ request.date_added }}</td>
                    <td class="text-right">
                      <a href="{{ request.view }}" class="btn btn-primary btn-xs">
                        <i class="fa fa-eye"></i> {{ text_view }}
                      </a>
                    </td>
                  </tr>
                  {% endfor %}
                {% else %}
                <tr>
                  <td class="text-center" colspan="9">{{ text_no_results }}</td>
                </tr>
                {% endif %}
              </tbody>
            </table>
          </div>
        </form>

      </div>
    </div>

    <div class="row">
      <div class="col-sm-6 text-left">{{ pagination }}</div>
      <div class="col-sm-6 text-right">{{ results }}</div>
    </div>

  </div>
</div>

<script type="text/javascript"><!--
$('#button-filter').on('click', function() {
    var url = 'index.php?route=extension/module/price_match/requests&user_token={{ user_token }}';
    var filter_product = $('#input-filter-product').val();
    if (filter_product) {
        url += '&filter_product=' + encodeURIComponent(filter_product);
    }
    var filter_email = $('#input-filter-email').val();
    if (filter_email) {
        url += '&filter_email=' + encodeURIComponent(filter_email);
    }
    var filter_status = $('#input-filter-status').val();
    if (filter_status !== '') {
        url += '&filter_status=' + encodeURIComponent(filter_status);
    }
    location = url;
});

$('#button-delete').on('click', function() {
    var selected = [];
    $('input[name="selected[]"]:checked').each(function() {
        selected.push($(this).val());
    });
    if (selected.length > 0) {
        if (confirm('{{ text_confirm }}')) {
            $('#form-price-match-list').submit();
        }
    } else {
        alert('{{ error_no_selection }}');
    }
});
//--></script>
{{ footer }}
